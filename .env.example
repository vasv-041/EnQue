# ==========================================
# EnQue - Configuration & Environment Setup
# ==========================================

# LLM Provider Configuration ("auto", "groq", or "ollama")
LLM_PROVIDER=auto

# Groq Cloud LLM Configuration (High Speed Cloud Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
FALLBACK_LLM_MODEL=qwen/qwen3.8-27b

# Ollama Local LLM Configuration (Optional Local Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Database Configuration (PostgreSQL with pgvector for production; SQLite fallback supported)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enque_db
# DATABASE_URL=sqlite:///./enque_dev.db

# Hindsight Persistent Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.ai/v1
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# JWT Authentication Security
JWT_SECRET_KEY=enque_super_secret_jwt_key_hackwithbangalore_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode
ENVIRONMENT=development
